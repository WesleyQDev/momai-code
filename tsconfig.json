{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": false,
    "noImplicitAny": false,
    "allowJs": false,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "runtime.ts",
    "worker.ts",
    "runtime-shim.d.ts",
    "core/**/*.ts",
    "tools/**/*.ts",
    "routes/**/*.ts",
    "test/**/*.ts"
  ]
}
